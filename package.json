{
  "name": "charlesmobile",
  "version": "0.1.0",
  "private": true,
  "main": "expo-router/entry",
  "packageManager": "pnpm@10.34.6",
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node scripts/dev-network/check.js && expo start --dev-client",
    "sync:api": "node scripts/sync-api.mjs",
    "generate:api": "node scripts/generate-api-types.mjs",
    "check:api": "node scripts/check-api-types.mjs",
    "lint": "eslint . --max-warnings 0",
    "typecheck": "node scripts/generate-route-types.js && tsc --noEmit",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "verify": "pnpm check:api && pnpm lint && pnpm typecheck && pnpm format:check && pnpm test:coverage --ci",
    "build:dev:android": "eas build --profile development --platform android",
    "start:skip-check": "expo start --dev-client"
  },
  "dependencies": {
    "@expo-google-fonts/inter": "0.4.2",
    "@expo/vector-icons": "15.1.1",
    "@hookform/resolvers": "5.9.1",
    "@lyracom/react-native-sdk-payment-module": "4.0.1",
    "@react-native-community/netinfo": "12.0.1",
    "@tanstack/react-query": "5.104.1",
    "expo": "57.0.27",
    "expo-build-properties": "57.0.22",
    "expo-constants": "57.0.21",
    "expo-crypto": "57.0.3",
    "expo-dev-client": "57.0.19",
    "expo-device": "57.0.2",
    "expo-font": "57.0.4",
    "expo-linking": "57.0.12",
    "expo-localization": "57.0.2",
    "expo-location": "57.0.20",
    "expo-navigation-bar": "57.0.3",
    "expo-notifications": "57.0.22",
    "expo-router": "57.0.25",
    "expo-secure-store": "57.0.4",
    "expo-splash-screen": "57.0.9",
    "expo-status-bar": "57.0.1",
    "expo-system-ui": "57.0.4",
    "i18next": "26.4.2",
    "openapi-fetch": "0.17.0",
    "react": "19.2.3",
    "react-hook-form": "7.89.0",
    "react-i18next": "17.0.16",
    "react-native": "0.86.3",
    "react-native-maps": "1.27.2",
    "react-native-safe-area-context": "5.7.0",
    "react-native-screens": "4.26.2",
    "zod": "4.6.5",
    "zustand": "5.0.15"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.0.1",
    "@types/jest": "29.5.14",
    "@types/react": "19.2.18",
    "eslint": "9.39.5",
    "eslint-config-expo": "57.0.2",
    "eslint-config-prettier": "10.1.8",
    "jest": "29.7.0",
    "jest-expo": "57.0.5",
    "openapi-typescript": "7.13.0",
    "prettier": "3.9.9",
    "typescript": "6.0.3"
  }
}
