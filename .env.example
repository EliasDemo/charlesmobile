# Origen del backend, sin /api/v1 (las rutas del contrato ya lo incluyen).
# En desarrollo: la IP local de tu computadora en la misma red wifi (ipconfig → IPv4).
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000


# Ponlo en true solo cuando la compilación instalada incluya la clave de Google Maps
# (variable de EAS GOOGLE_MAPS_ANDROID_API_KEY). La clave nunca va aquí.
EXPO_PUBLIC_MAPS_ANDROID_ENABLED=false

