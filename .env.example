# Origen del backend, sin /api/v1 (las rutas del contrato ya lo incluyen).
# En desarrollo: la IP local de tu computadora en la misma red wifi (ipconfig → IPv4).
EXPO_PUBLIC_API_URL=http://192.168.1.50:3000

# Enlaces provisionales a los términos y a la política de privacidad, hasta que
# GET /auth/terms los devuelva. Si faltan, la app oculta el enlace.
EXPO_PUBLIC_TERMS_URL=https://charlesapp.pe/terminos
EXPO_PUBLIC_PRIVACY_URL=https://charlesapp.pe/privacidad
